# Dependencies
node_modules/
client/node_modules/

# Build outputs
dist/
client/dist/

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Docker volumes (if local)
postgres_data/
bookstack_data/
bookstack_db_data/

# TypeScript
*.tsbuildinfo

# Compiled JS files in src (using tsx)
src/**/*.js

# Root scripts folder (keep ignored by default, but track scripts/gcp and scripts/deploy)
!/scripts/
/scripts/*
!/scripts/gcp/
!/scripts/gcp/**
!/scripts/deploy/
!/scripts/deploy/**
!/scripts/secrets/
!/scripts/secrets/**

