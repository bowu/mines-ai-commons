ui.png
ui-agents-current.png
ui-skills-current.png
ui-wiki-current.png
mockup.html
data/
.dev/
playwright-report/
test-results/

# Local embedded repos (do not track in this repo)
openclaw/
openwork/

# Sandbox runtime state (generated at runtime, not for version control)
sandbox/.sandbox-state/

# Planning docs are committed
!PLAN.md
!plans/
!plans/**
