__DOMAIN__ {
  encode zstd gzip

  root * /opt/mines-ai/current/client
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';"
  }

  route {
    handle_path /litellm/* {
      reverse_proxy 127.0.0.1:4000
    }

    handle /api/* {
      reverse_proxy 127.0.0.1:3001
    }

    handle /assets/* {
      try_files {path} =404
      file_server
    }

    try_files {path} /index.html
    file_server
  }
}

www.__DOMAIN__ {
  redir https://__DOMAIN__{uri} 308
}
