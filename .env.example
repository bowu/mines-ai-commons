# Mines AI Commons environment template
# Copy to `.env` and fill as needed.
# `pnpm dev` works without a `.env` file, but magic-link auth / GCE mode need explicit values.

# -------------------------------
# Core Database
# -------------------------------
DATABASE_URL=postgresql://mines_ai:mines_ai_password@localhost:5435/mines_ai
# Optional: when using scripts/secrets/sync-production-env-from-dotenv.sh,
# set this to force production secret DATABASE_URL without changing local dev URL.
# PROD_DATABASE_URL=postgresql://app_user:password@127.0.0.1:5432/mines_ai
# APP_DATABASE_URL=postgresql://app_user_login:password@localhost:5435/mines_ai
# VM_INTERNAL_DATABASE_URL=postgresql://internal_vm_user_login:password@localhost:5435/mines_ai
# AUTH_BOOTSTRAP_DATABASE_URL=postgresql://auth_bootstrap_user_login:password@localhost:5435/mines_ai
# DB_POOL_MAX=20
# DB_POOL_IDLE_TIMEOUT_MS=30000
# DB_POOL_CONNECTION_TIMEOUT_MS=10000
# READINESS_DB_TIMEOUT_MS=3000

# -------------------------------
# Auth (general)
# -------------------------------
# AUTH_PROVIDER=none|oidc|magic
AUTH_PROVIDER=none
# Local dev note: `pnpm dev` forces AUTH_PROVIDER=none by default.
# To test auth flows locally, set DEV_AUTH_PROVIDER explicitly:
# DEV_AUTH_PROVIDER=magic pnpm dev
# DEV_AUTH_PROVIDER=oidc pnpm dev
# AUTH_EMAIL_WHITELIST=alice@mines.edu,bob@mines.edu
# SESSION_SECRET=replace-with-long-random-secret
PUBLIC_URL=http://localhost:5173
# Optional: when using scripts/secrets/sync-production-env-from-dotenv.sh,
# set this to force production secret PUBLIC_URL without changing local dev URL.
# PROD_PUBLIC_URL=https://mines-ai.com
# CORS_ORIGINS=https://staging.mines.edu,https://mines.edu
# DEFAULT_USER_EMAIL=admin@mines.edu
# DEFAULT_USER_NAME=Default Admin
# DEFAULT_ORG_SLUG=mines
# AGENT_CREATE_RATE_LIMIT_WINDOW_MS=600000
# AGENT_CREATE_RATE_LIMIT_MAX=10
# AGENT_CHAT_RATE_LIMIT_WINDOW_MS=60000
# AGENT_CHAT_RATE_LIMIT_MAX=120
# CHAT_RESUMABLE_STREAM=true
# CHAT_RESUMABLE_MAX_EVENT_BYTES=8192
# CHAT_RESUMABLE_MAX_EVENTS_PER_TURN=500
# CHAT_RESUMABLE_MAX_TURN_BYTES=4194304
# CHAT_RESUMABLE_MAX_ACTIVE_TURNS=50
# CHAT_RESUMABLE_TTL_MS=1800000

# -------------------------------
# Auth (Magic Link via SendGrid)
# Required when AUTH_PROVIDER=magic
# -------------------------------
# SENDGRID_API_KEY=SG.xxxxxx
# AUTH_MAGIC_FROM_EMAIL=no-reply@mines-ai.com
# AUTH_MAGIC_LINK_SECRET=replace-with-long-random-secret
# AUTH_MAGIC_LINK_TTL_MS=600000
# AUTH_MAGIC_REQUEST_RATE_LIMIT_WINDOW_MS=60000
# AUTH_MAGIC_REQUEST_RATE_LIMIT_MAX=5
# AUTH_MAGIC_VERIFY_RATE_LIMIT_WINDOW_MS=60000
# AUTH_MAGIC_VERIFY_RATE_LIMIT_MAX=30
# AUTH_MAGIC_RESEND_COOLDOWN_MS=30000

# -------------------------------
# Auth (OIDC)
# Required when AUTH_PROVIDER=oidc
# -------------------------------
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_CALLBACK_URL=http://localhost:3001/api/auth/callback

# -------------------------------
# Sandbox Control Plane
# -------------------------------
SANDBOX_MODE=local
SANDBOX_LOCAL_URL=http://127.0.0.1:8888
# In GCE mode this must be a stable public HTTPS endpoint reachable by VM startup script.
API_CALLBACK_URL=http://localhost:3001
# Production env sync can override callback URL with this value.
# Defaults to PROD_PUBLIC_URL when present, otherwise API_CALLBACK_URL.
# PROD_API_CALLBACK_URL=https://mines-ai.com
# For advanced deployments only: allow callback host to differ from PUBLIC_URL.
# ALLOW_API_CALLBACK_HOST_MISMATCH=true
# pnpm dev forces a local callback URL by default. Use this only if you need to override it.
# DEV_LOCAL_API_CALLBACK_URL=http://127.0.0.1:3001
# DEV_GCE_CALLBACK_PUBLIC_URL=https://callback.mines-ai.com
# DEV_GCE_PROXY_PUBLIC_URL=https://proxy-dev.mines-ai.com
# DEV_GCE_USE_QUICK_TUNNEL=true
# DEV_GCE_USE_QUICK_PROXY_TUNNEL=true
# DEV_GCE_USE_LOCAL_PROXY=false
# Default in `pnpm dev:gce` is true for legacy image compatibility.
# Set false to enforce proxy-only behavior during GCE dev testing.
# DEV_GCE_ALLOW_PROVIDER_KEYS=true
# DEV_GCE_FORCE_RUNTIME_BUNDLE=false
# VM_SERVICE_ACCOUNT_EMAIL=
# VM_TOKEN_SECRET=replace-with-long-random-secret
# VM_BOOTSTRAP_SECRET=replace-with-long-random-secret

# -------------------------------
# GCP / Compute
# -------------------------------
# GCP_PROJECT_ID=mines-ai-488015
# GCP_ZONE=us-central1-f
# GCP_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
GCE_IMAGE_PROJECT=mines-ai-488015
GCE_IMAGE_FAMILY=mines-sandbox-runtime
# SANDBOX_EXPECTED_RUNTIME_VERSION=
# SANDBOX_BASE_IMAGE_PROJECT=mines-ai-488015
# SANDBOX_BASE_IMAGE_FAMILY=mines-sandbox-base
# GCE_MACHINE_TYPE=e2-medium
# GCE_GPU_MACHINE_TYPE=n1-standard-4
# GCE_GPU_TYPE=nvidia-tesla-t4
# GCE_NETWORK=default
# GCE_SUBNETWORK=
# GCE_BOOT_DISK_SIZE_GB=30
# GCE_DATA_DISK_SIZE_GB=50
# GCE_USE_EXTERNAL_IP=true
# GCE_ORPHAN_MAX_AGE_MS=7200000
# SANDBOX_ORPHAN_SWEEP_DELETE_ENABLED=false

# -------------------------------
# Sandbox Runtime Timing
# -------------------------------
# SANDBOX_HEALTH_PROBE_TIMEOUT_MS=5000
# SANDBOX_READY_RETRY_AFTER_MS=5000
# SANDBOX_IDLE_POLL_INTERVAL_MS=5000
# SANDBOX_IDLE_CPU_MS=900000
# SANDBOX_IDLE_GPU_MS=900000
# SANDBOX_ACTIVITY_TOUCH_MIN_INTERVAL_MS=15000
# SANDBOX_STREAM_LEASE_REFRESH_MS=30000
# SANDBOX_STREAM_LEASE_TTL_MS=90000
# SANDBOX_RECONCILE_DB_QUERY_TIMEOUT_MS=15000
# SANDBOX_GCE_OPERATION_TIMEOUT_MS=120000
# Optional override. Default is 120000 in non-production GCE, 300000 otherwise.
# SANDBOX_STARTUP_GRACE_MS=300000
# PI_AGENT_MAX_RUNTIME_MS=18000000

# -------------------------------
# Wake Trace
# -------------------------------
# SANDBOX_WAKE_TRACE_LOGS=false
# SANDBOX_WAKE_TRACE_AGENT_IDS=
# SANDBOX_WAKE_TRACE_FILE_PATH=data/logs/wake-trace.ndjson
# SANDBOX_WAKE_TRACE_CONSOLE=false
# VITE_WAKE_TRACE_LOGS=false

# -------------------------------
# AI / Inference Proxy (required for production and `pnpm dev:gce`)
# -------------------------------
# OpenAI-compatible LiteLLM proxy endpoint used by agent sessions.
# The app routes Gemini/Sonnet/Opus/GPT through this proxy in GCE/prod.
# Local dev default: direct provider keys (no proxy required).
# To force local sandbox through proxy, set LOCAL_USE_LITELLM_PROXY=true.
# GCE dev/prod: always proxy path.
# LITELLM_PROXY_URL=http://127.0.0.1:4000/v1
# LITELLM_PROXY_API_KEY=replace-with-proxy-key
# LITELLM_MODEL_GEMINI=gemini-3.1-pro
# LITELLM_MODEL_SONNET=sonnet-4.6
# LITELLM_MODEL_OPUS=opus-4.6
# LITELLM_MODEL_GPT=gpt-5.2
# LOCAL_USE_LITELLM_PROXY=false
# SANDBOX_LOCAL_GEMINI_MODEL_ID=gemini-3.1-pro-preview
# SANDBOX_LOCAL_SONNET_MODEL_ID=global.anthropic.claude-sonnet-4-6
# SANDBOX_LOCAL_OPUS_MODEL_ID=global.anthropic.claude-opus-4-6-v1

# -------------------------------
# AI / External Providers (control-plane only)
# -------------------------------
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# BRAVE_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2
# CLAUDE_CODE_USE_BEDROCK=true
# BEDROCK_ROLE_ARN=

# -------------------------------
# Dev Tunnel (local only)
# -------------------------------
# CLOUDFLARED_TUNNEL_TOKEN=
# CLOUDFLARED_CONFIG=$HOME/.cloudflared/mines-ai-callback.yml
# CLOUDFLARED_PROXY_TUNNEL_TOKEN=
# CLOUDFLARED_PROXY_CONFIG=$HOME/.cloudflared/mines-ai-proxy.yml
